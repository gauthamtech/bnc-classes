# Line endings. This repo is edited on Windows and built on macOS, so normalise
# to LF in the repository and let each machine check out what it needs.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or cmd.exe mis-parses them.
*.bat  text eol=crlf
*.ps1  text eol=crlf
*.cmd  text eol=crlf

# gradlew is a shell script. With CRLF it fails on macOS with a "bad
# interpreter" error that looks nothing like a line-ending problem.
gradlew text eol=lf

# Xcode files are LF and fussy about it.
*.pbxproj    text eol=lf
*.swift      text eol=lf
*.storyboard text eol=lf
*.plist      text eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.woff2 binary
*.zip binary
*.apk binary
*.aab binary
*.jks binary
*.keystore binary
