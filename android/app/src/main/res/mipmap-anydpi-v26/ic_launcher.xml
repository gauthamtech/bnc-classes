<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. The launcher masks the foreground to whatever shape the
     handset uses, so the maskable artwork goes here rather than the plain
     logo, which would get its edges clipped. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ground" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
