<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BNC" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent" tools:targetApi="lollipop">@color/cyan</item>
    </style>

    <!-- Shown for the fraction of a second before the WebView paints. Without
         it the app opens on a white flash, which on a dark app is jarring and
         reads as a bug. -->
    <style name="Theme.BNC.Splash" parent="Theme.BNC">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
