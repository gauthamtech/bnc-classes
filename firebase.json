{
  "hosting": {
    "target": "app",
    "public": "web/dist",
    "ignore": ["**/.*", "**/node_modules/**", "**/_redirects", "**/.htaccess"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|png|jpg|jpeg|svg|webmanifest)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
